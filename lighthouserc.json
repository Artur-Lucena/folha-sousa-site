{
  "ci": {
    "collect": {
      "startServerCommand": "npx --no-install vinext start -p 3200 -H 127.0.0.1",
      "startServerReadyPattern": "3200",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/agendar",
        "http://127.0.0.1:3200/perguntas-frequentes"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/relatorios"
    }
  }
}
